modules = ["nodejs-24", "postgresql-16"]
run = "pnpm install --frozen-lockfile && pnpm run dev"

[env]
PORT = "3000"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm run build"]
run = ["pnpm", "run", "start"]

[[ports]]
localPort = 3000
externalPort = 80
