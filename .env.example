# Copy to .env for local development only. Never commit real values.
# On Replit, set these in the Secrets tab instead.

# Postgres connection string. Leave unset locally to use the built-in
# file database in .local-db/ (no install needed).
# DATABASE_URL=postgres://user:password@host:5432/kynex

# Port the server listens on (Replit maps it to https automatically).
# PORT=3000

# Shared password for the phase 1 test accounts (admin@kynex.test, clinician1@kynex.test,
# patient1@kynex.test ...). At least 10 characters. On Replit: Secrets tab, name DEMO_PASSWORD.
# DEMO_PASSWORD=
